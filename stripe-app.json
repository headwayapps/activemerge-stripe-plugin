{
  "$schema": "https://stripe.com/stripe-app.schema.json",
  "id": "com.activemerge.app",
  "version": "0.0.1",
  "name": "ActiveMerge",
  "icon": "icon.png",
  "distribution_type": "public",
  "sandbox_install_compatible": true,
  "stripe_api_access_type": "platform",
  "permissions": [
    {
      "permission": "secret_write",
      "purpose": "Stores your ActiveMerge sign-in securely so you stay connected."
    },
    {
      "permission": "customer_read",
      "purpose": "Fills your document templates with the customer's name, email, phone and address."
    },
    {
      "permission": "invoice_read",
      "purpose": "Fills your document templates with invoice details and line items."
    }
  ],
  "ui_extension": {
    "views": [
      {
        "viewport": "settings",
        "component": "AppSettings"
      },
      {
        "viewport": "stripe.dashboard.drawer.default",
        "component": "Home"
      },
      {
        "viewport": "stripe.dashboard.customer.detail",
        "component": "CustomerDetail"
      },
      {
        "viewport": "stripe.dashboard.invoice.detail",
        "component": "InvoiceDetail"
      }
    ],
    "content_security_policy": {
      "connect-src": [
        "https://app.activemerge.com/api/stripe-app/",
        "https://app.activemerge.com/oauth/token"
      ],
      "purpose": "Signs you in to ActiveMerge and sends the selected template and Stripe data to ActiveMerge to generate your document."
    }
  },
  "post_install_action": {
    "type": "settings"
  },
  "constants": {
    "APP_ID": "com.activemerge.app",
    "AUTH_BASE": "https://app.activemerge.com",
    "API_BASE": "https://app.activemerge.com/api/stripe-app",
    "OAUTH_CLIENT_ID": "REPLACE_WITH_CLIENT_ID_FROM_ARTISAN_COMMAND"
  }
}
